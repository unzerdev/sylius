{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('bundles/syliusunzerplugin/admin/css/unzer_admin.scss') }}">
{% endblock %}

{% if not is_unzer_enabled() %}
<form action="{{ path('unzer_admin_enable') }}" method="post" class="d-inline">
    <button class="btn unzer-button" onclick="{{ path('unzer_admin_enable') }}">
        <img src="{{ asset('bundles/syliusunzerplugin/admin/images/unzer_icon.png') }}" alt="Custom Icon" class="unzer-icon"/>
        {{ 'sylius_unzer_plugin.ui.configuration.button.enable'|trans }}
    </button>
</form>
{% endif %}
