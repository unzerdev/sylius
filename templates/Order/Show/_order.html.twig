{% import "@SyliusShop/shared/macro/money.html.twig" as money %}

{% set order = hookable_metadata.context.order %}
{% set transaction = unzer_transaction(order) %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('bundles/syliusunzerplugin/admin/css/unzer_admin.scss') }}">
{% endblock %}

{% if transaction and transaction.items is not empty %}

    <div class="card mb-3">
        {# Logo display #}
        <div class="card-header">
            <div class="unzer-logo-container">
                <img class="unzer-logo" src="{{ asset('bundles/syliusunzerplugin/admin/images/unzer_logo.png') }}"
                     alt="unzer_logo">
                <div class="card-title">{{ 'sylius_unzer_plugin.order.unzer.label'|trans }}</div>
            </div>
        </div>
        {# Transaction table title #}
        <div class="card-header">
            <div class="card-title">
                {{ 'sylius_unzer_plugin.order.transaction_details.header'|trans }}
            </div>
        </div>
        {# Transaction table #}
        <div class="table-responsive">
            <table class="table table-hover table-vcenter card-table">
                <thead>
                <tr>
                    <th class="text-left"> {{ 'sylius_unzer_plugin.order.transaction_details.date'|trans }}</th>
                    <th class="text-left">{{ 'sylius_unzer_plugin.order.transaction_details.payment_id'|trans }}</th>
                    <th class="text-left">{{ 'sylius_unzer_plugin.order.transaction_details.payment_method'|trans }}</th>
                    <th class="text-left">{{ 'sylius_unzer_plugin.order.transaction_details.authorized'|trans }}</th>
                    <th class="text-left">{{ 'sylius_unzer_plugin.order.transaction_details.charged'|trans }}</th>
                    <th class="text-left">{{ 'sylius_unzer_plugin.order.transaction_details.refunded'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                <td class="text-left">{{ transaction.items[0].date }}</td>
                <td class="text-left">{{ transaction.items[0].paymentId }}</td>
                <td class="text-left">
                    <img class="unzer-transaction-image" alt="{{ transaction.type }}"
                         src="{{ asset('bundles/syliusunzerplugin/admin-ui/images/' ~ transaction.items[0].paymentType ~ '.svg') }}"
                         onerror="this.onerror=null;this.src='{{ asset('bundles/syliusunzerplugin/admin-ui/images/default.svg') }}';"/>
                    <span class="unzer-transaction-label">{{ transaction.typeLabel }}</span>
                </td>
                <td class="text-left">{{ money.format((transaction.amounts.authorized.amount * 100)|round, transaction.amounts.authorized.currency) }}</td>
                <td class="text-left">{{ money.format((transaction.amounts.charged.amount * 100)|round, transaction.amounts.charged.currency) }}</td>
                <td class="text-left">{{ money.format((transaction.amounts.refunded.amount * 100)|round, transaction.amounts.refunded.currency) }}</td>
                </tbody>
            </table>
        </div>

        {# History table title #}
        <div class="card-header">
            <div class="card-title">
                {{ 'sylius_unzer_plugin.order.transaction_history.header'|trans }}
            </div>
        </div>
        {# History table #}
        <div class="table-responsive">
            <table class="table table-hover table-vcenter card-table">
                <thead>
                <tr>
                    <th class="text-left"> {{ 'sylius_unzer_plugin.order.transaction_history.date'|trans }}</th>
                    <th class="text-left"> {{ 'sylius_unzer_plugin.order.transaction_history.payment_id'|trans }}</th>
                    <th class="text-left"> {{ 'sylius_unzer_plugin.order.transaction_history.transaction_id'|trans }}</th>
                    <th class="text-left"> {{ 'sylius_unzer_plugin.order.transaction_history.payment_method'|trans }}</th>
                    <th class="text-left"> {{ 'sylius_unzer_plugin.order.transaction_history.type'|trans }}</th>
                    <th class="text-left"> {{ 'sylius_unzer_plugin.order.transaction_history.status'|trans }}</th>
                    <th class="text-left"> {{ 'sylius_unzer_plugin.order.transaction_history.amount'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for item in transaction.items %}
                    <tr>
                        <td class="text-left">{{ item.date }}</td>
                        <td class="text-left">{{ item.paymentId }}</td>
                        <td class="text-left">{{ item.id }}</td>
                        <td class="text-left">
                            <img class="unzer-transaction-image" alt="{{ transaction.type }}"
                                 src="{{ asset('bundles/syliusunzerplugin/admin-ui/images/' ~ item.paymentType ~ '.svg') }}"
                                 onerror="this.onerror=null;this.src='{{ asset('bundles/syliusunzerplugin/admin-ui/images/default.svg') }}';"/>
                            <span class="unzer-transaction-label">{{ item.paymentTypeLabel }}</span>

                        </td>
                        <td class="text-left">{{ item.type|capitalize }} </td>
                        <td class="text-left">{{ item.status }} </td>
                        <td class="text-left">{{ money.format((item.amount.amount * 100)|round, item.amount.currency) }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
