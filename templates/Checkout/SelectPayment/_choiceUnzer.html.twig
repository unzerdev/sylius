<div class="hidden" hidden {{ sylius_test_html_attribute('payment-method-checkbox') }}>
    {{ form_widget(form, {
        'label': false,
        'attr': {
            'hidden': '',
            'class': 'hidden',
            'data-test-payment-method-select': ''
        }
    }) }}
</div>

{{ render(controller('SyliusUnzerPlugin\\Controller\\CheckoutPaymentController::renderPaymentTypes', {'orderId': order.id, 'form': form})) }}

<script type="text/javascript">
    //# sourceURL=_choicesUnzer.js
    document.addEventListener('DOMContentLoaded', () => {
        let unzerMainPaymentInput = document.getElementById('{{ form.vars.id }}');
        let unzerDefaultPaymentMethodType = document.getElementById('unzer_payment_method_type_none');
        let nativePaymentMethods = document.querySelectorAll("[name='{{ form.vars.full_name }}']");
        let unzerPaymentMethodTypes = document.querySelectorAll('input[data-unzer-payment-method]');
        let unzerPaymentMethodType = document.getElementById('unzer-payment-method-type');

        for (let i = 0; i < unzerPaymentMethodTypes.length; i++) {
            unzerPaymentMethodTypes[i].addEventListener('change', function () {

                unzerPaymentMethodTypes.forEach(input => {
                    if (input !== this) {
                        input.checked = false;
                    }
                });

                // Select the current input
                this.checked = true;
                unzerPaymentMethodType.value = this.value;
                unzerPaymentMethodType.checked = true;
                unzerMainPaymentInput.checked = true;
            });
        }
        for (let i = 0; i < nativePaymentMethods.length; i++) {
            nativePaymentMethods[i].addEventListener('change', function () {
                unzerPaymentMethodTypes.forEach(input => {
                    input.checked = false;
                    unzerPaymentMethodType.checked = false;
                });
                unzerDefaultPaymentMethodType.checked = true;
            });
        }

        let isAnyChecked = Array.from(unzerPaymentMethodTypes).some(input => input.checked);
        if (!isAnyChecked && nativePaymentMethods.length === 1) {
            unzerPaymentMethodTypes[0].checked = true;
        }

        let checkedInput = Array.from(unzerPaymentMethodTypes).find(input => input.checked);

        if (checkedInput) {
            unzerPaymentMethodType.value = checkedInput.value;
            unzerPaymentMethodType.checked = true;
            unzerMainPaymentInput.checked = true;
        }
    });
</script>

{% if (sylius_order_can_be_paid(order)) %}
    {% hook 'unzer.shop.order.show.before_navigation' with  {'order': order} %}
{% endif %}
